{
  "name": "armature/mcp-analytics",
  "description": "Armature analytics instrumentation for Model Context Protocol servers in PHP",
  "license": "Apache-2.0",
  "type": "library",
  "require": {
    "php": "^8.1",
    "mcp/sdk": ">=0.7.0 <0.8.0",
    "psr/container": "^1.0 || ^2.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "symfony/http-client": "^6.4 || ^7.3 || ^8.0",
    "symfony/uid": "^5.4 || ^6.4 || ^7.3 || ^8.0"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.48",
    "friendsofphp/php-cs-fixer": "^3.84",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Armature\\McpAnalytics\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Armature\\McpAnalytics\\Tests\\": "tests/"
    }
  },
  "archive": {
    "exclude": [
      "/.github",
      "/.phpstan-cache",
      "/.phpunit.cache",
      "/canary",
      "/composer.lock",
      "/dist",
      "/tests",
      "/vendor"
    ]
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true
    },
    "sort-packages": true
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "check": [
      "@test",
      "@analyse",
      "@lint",
      "@normalize"
    ],
    "lint": "php-cs-fixer fix --dry-run --diff --using-cache=no",
    "normalize": "composer normalize --dry-run",
    "test": "phpunit"
  }
}
